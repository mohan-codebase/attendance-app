MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
JWT_SECRET=<random-long-string>
PORT=5000
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=<your-oauth-client-id>.apps.googleusercontent.com

# Where the app is served from. Used to build the password reset link in the
# email, so it must point at the frontend, not the API.
CLIENT_URL=http://localhost:3000

# Password reset email (any SMTP provider: Gmail app password, Brevo, Mailgun,
# SendGrid, Resend...). Until these are set, reset links are printed to the
# server console in development and refused in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
SMTP_FROM=PresentSir <no-reply@yourdomain.com>
